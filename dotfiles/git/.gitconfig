[user]
	name = Joseph Lozano
	email = joseph@hey.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIANVfta972guG1JXAiGa9x64dsBShEbDL4ps7Yxqb9I+

[core]
	editor = nvim
	autocrlf = input
	excludesfile = ~/.gitignore_global

[init]
	defaultBranch = main

[push]
	default = simple
	autoSetupRemote = true

[pull]
	ff = only

[merge]
	tool = nvim

[diff]
	tool = nvim



[color]
	ui = auto

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold

[color "status"]
	added = yellow
	changed = green
	untracked = cyan

[alias]
	hist = log --pretty=format:'%C(yellow)[%ad]%C(reset) %C(green)[%h]%C(reset) | %C(red)%s %C(bold red){{%an}}%C(reset) %C(blue)%d%C(reset)' --graph --date=short
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
